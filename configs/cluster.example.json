{
  "schema_version": 1,
  "description": "Fill actual scheduler account/partition/time and concurrency after probe. GPU counts are requested isolation configurations, not hardware minimum claims. Do not reuse another project environment automatically.",
  "launcher_python": "python3",
  "max_parallel": null,
  "defaults": {
    "account": null,
    "partition": null,
    "time": null,
    "qos": null,
    "cpus": 4,
    "memory": "32G"
  },
  "resources": {
    "preflight": {
      "gpus": 0,
      "python": "${ICS_RUNTIME}/envs/insid3/bin/python"
    },
    "insid3": {
      "gpus": 1,
      "python": "${ICS_RUNTIME}/envs/insid3/bin/python"
    },
    "cgics_visual": {
      "gpus": 1,
      "python": "${ICS_RUNTIME}/envs/cgics/bin/python"
    },
    "cgics_mllm": {
      "gpus": 2,
      "python": "${ICS_RUNTIME}/envs/cgics/bin/python",
      "mllm_mode": "owned",
      "mllm_python": "${ICS_RUNTIME}/envs/mllm/bin/python",
      "mllm_model_path": "${ICS_RUNTIME}/weights/Qwen3-VL-4B-Instruct",
      "mllm_gpu_memory_utilization": 0.85,
      "mllm_startup_timeout": 900,
      "mllm_max_model_len": 16384,
      "mllm_max_num_seqs": 5,
      "mllm_processor_cache_gb": 0
    }
  },
  "max_array_size": 1000,
  "max_submit_tasks": null
}

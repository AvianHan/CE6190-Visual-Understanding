  "max_parallel": 8,
  "max_array_size": 1000,
  "max_submit_tasks": 60,
  "defaults": {
    "account": "prj0000000262",
    "partition": "h200p",
    "qos": "highpriority",
    "time": "12:00:00",
    "cpus": 4,
    "memory": "32G"
  },
  "resources": {
    "preflight": {
      "partition": "cpup",
      "time": "08:00:00",
      "gpus": 0,
      "python": "${ICS_RUNTIME}/envs/insid3/bin/python"
    },
    "insid3": {
      "gpus": 1,
      "max_parallel": 4,
      "python": "${ICS_RUNTIME}/envs/insid3/bin/python"
    },
    "cgics_visual": {
      "gpus": 1,
      "max_parallel": 2,
      "python": "${ICS_RUNTIME}/envs/cgics/bin/python"
    },
    "cgics_mllm": {
      "gpus": 2,
      "max_parallel": 2,
      "cpus": 8,
      "memory": "64G",
      "python": "${ICS_RUNTIME}/envs/cgics/bin/python",

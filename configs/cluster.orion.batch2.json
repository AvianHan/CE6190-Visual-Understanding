{
  "schema_version": 1,
  "description": "Batch2: shared highpriority cap60; dedicated SAM+MLLM GPUs. Preserve recorded repair exclusions A484652X3B10601 for GPU profiles and 2FS9B74 for CG-ICS MLLM; these are historical job evidence, not a current physical-node diagnosis. Record hardware per job.",
  "launcher_python": "${ICS_RUNTIME}/envs/insid3/bin/python",
  "max_parallel": 60,
  "max_array_size": 1000,
  "max_submit_tasks": 60,
  "defaults": {
    "account": "prj0000000262",
    "partition": "h200p",
    "qos": "highpriority",
    "time": "12:00:00",
    "cpus": 4,
    "memory": "32G"
  },
  "resources": {
    "preflight": {
      "partition": "cpup",
      "time": "08:00:00",
      "gpus": 0,
      "python": "${ICS_RUNTIME}/envs/insid3/bin/python"
    },
    "insid3": {
      "gpus": 1,
      "max_parallel": 60,
      "python": "${ICS_RUNTIME}/envs/insid3/bin/python",
      "exclude": "A484652X3B10601"
    },
    "cgics_visual": {
      "gpus": 1,
      "max_parallel": 60,
      "python": "${ICS_RUNTIME}/envs/cgics/bin/python",
      "exclude": "A484652X3B10601"
    },
    "cgics_mllm": {
      "gpus": 2,
      "max_parallel": 60,
      "cpus": 8,
      "memory": "64G",
      "python": "${ICS_RUNTIME}/envs/cgics/bin/python",
      "mllm_mode": "owned",
      "mllm_python": "${ICS_RUNTIME}/envs/mllm/bin/python",
      "mllm_model_path": "${ICS_RUNTIME}/weights/Qwen3-VL-4B-Instruct",
      "mllm_gpu_memory_utilization": 0.85,
      "mllm_startup_timeout": 900,
      "mllm_max_model_len": 16384,
      "mllm_max_num_seqs": 5,
      "mllm_processor_cache_gb": 0,
      "exclude": "2FS9B74,A484652X3B10601"
    }
  }
}
